# LOCAL development. Copy to .env.local (git-ignored) and fill in.

# Server-only API address (the backend running on your machine).
BACKEND_API_URL=http://127.0.0.1:9090/api/v1

# Firebase web app config (public identifiers). Local uses the default firebaseapp.com domain.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=laidoffcircle.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=laidoffcircle
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Maps (Maps JavaScript API + Places API (New)). Restrict to http://localhost:3000/*.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional. Defaults to ws://<current host>:9090/ws, which is right for local.
# NEXT_PUBLIC_WS_URL=ws://localhost:9090/ws
