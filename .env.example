# Server-only API address. Do not prefix with NEXT_PUBLIC.
BACKEND_API_URL=http://127.0.0.1:9090/api/v1
# Firebase web app config for Google sign-in. These are public client identifiers.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional WebSocket address for live messages and notifications. Defaults to
# ws(s)://<current host>:9090/ws. The page origin must be in the API's CORS_ORIGINS.
# NEXT_PUBLIC_WS_URL=ws://localhost:9090/ws

# Optional canonical browser origin when running behind a reverse proxy.
# AUTH_APP_ORIGIN=https://your-domain.example

# Optional Google Maps key for location suggestions on referrals. Enable
# "Maps JavaScript API" and "Places API (New)". Restrict it to your site origin.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
